FROM node:20-slim

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.5 --activate

WORKDIR /ui
ARG AGENT_UI_COMMIT=6dad9593fca6756e1813e4f4b3b2620be6377691
RUN git init \
    && git remote add origin https://github.com/agno-agi/agent-ui.git \
    && git fetch --depth 1 origin ${AGENT_UI_COMMIT} \
    && git checkout --detach FETCH_HEAD

COPY agent-ui.patch /tmp/agent-ui.patch
RUN git apply /tmp/agent-ui.patch && rm /tmp/agent-ui.patch

ARG NEXT_PUBLIC_OS_SECURITY_KEY
ENV NEXT_PUBLIC_OS_SECURITY_KEY=${NEXT_PUBLIC_OS_SECURITY_KEY}
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm install --frozen-lockfile
RUN pnpm build

EXPOSE 3000
CMD ["pnpm", "start"]
