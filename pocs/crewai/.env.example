# Copy to .env. CrewAI reads the same provider and model as the Agno POC.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.io/v1
MODEL_ID=MiniMax-M3.1-Flash
CREWAI_API_KEY=

CREWAI_API_PORT=7790
CREWAI_LIBRECHAT_PORT=3081
CREWAI_BACKSTAGE_PORT=7008
CREWAI_LANGFUSE_PORT=3002

CREWAI_LIBRECHAT_JWT_SECRET=
CREWAI_LIBRECHAT_REFRESH_SECRET=
CREWAI_LIBRECHAT_CREDS_KEY=
CREWAI_LIBRECHAT_CREDS_IV=
CREWAI_BACKSTAGE_DB_PASSWORD=crewai-local-backstage

# Create a Langfuse project in the CrewAI Langfuse UI, then paste its keys here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_OTEL_ENDPOINT=http://langfuse-web:3000/api/public/otel/v1/traces
CREWAI_LANGFUSE_SALT=crewai-local-development-salt
CREWAI_LANGFUSE_NEXTAUTH_SECRET=crewai-local-development-nextauth
