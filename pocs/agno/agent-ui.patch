+  getFactorySkillCatalogAPI,
+  getTeamRuntimeDetailsAPI
+} from '@/api/os'
+import { Button } from '@/components/ui/button'
+import { useStore } from '@/store'
+import {
+  AgentOSModelSummary,
+  FactoryCatalogSkill,
+  RuntimeTool,
+  TeamRuntimeDetails,
+  AgentRuntimeDetails
